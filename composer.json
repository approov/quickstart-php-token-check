{
  "name": "approov/quickstart-php-token-check",
  "description": "Approov token verification quickstart (plain PHP).",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "vlucas/phpdotenv": "^5.6.3"
